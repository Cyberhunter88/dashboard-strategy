{
  "name": "dashboard-strategy",
  "version": "1.33.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "webpack",
    "build-dev": "webpack --config webpack.dev.config.ts",
    "watch": "webpack --config webpack.dev.config.ts --watch",
    "version:read": "node scripts/read-version.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/verify-version-sync.mjs",
    "verify:version": "npm run version:check",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/verify-browser-optimization.mjs",
    "verify:quality": "npm run typecheck && npm run lint && npm run format:check && node scripts/lint-translations.mjs && npm test",
    "verify:production": "node scripts/verify-version-sync.mjs && node scripts/verify-production-artifacts.mjs && node scripts/verify-hacs-distribution.mjs",
    "verify:release": "npm run verify:quality && npm run build && npm run verify:production"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "compression-webpack-plugin": "^12.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "home-assistant-js-websocket": "^9.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  }
}
